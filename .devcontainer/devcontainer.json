{
  "name": "FreeLLMAPI",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": { "label": "FreeLLMAPI", "onAutoForward": "openBrowser" }
  }
}
